---
import { equipo } from "../../data/equipoData.js";
---

<section id="equipo" class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <span class="text-green-dark font-bold text-xs uppercase tracking-widest">Nuestro equipo</span>
    <h2 class="text-navy text-3xl md:text-4xl font-extrabold mt-2 mb-14">
      Las personas detrás de CEFSA
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
      {
        equipo.map((persona) => (
          <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
            <div class="w-20 h-20 mx-auto rounded-full bg-navy text-white flex items-center justify-center text-2xl font-extrabold mb-5">
              {persona.iniciales}
            </div>
            <h3 class="font-bold text-navy text-lg">{persona.nombre}</h3>
            <p class="text-green-dark font-semibold text-sm mb-3">{persona.cargo}</p>
            <p class="text-gray-600 text-sm leading-relaxed">{persona.detalle}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
