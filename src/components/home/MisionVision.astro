---
import Badge from "./badge.astro";

const values = [
  "Compromiso",
  "Integridad",
  "Excelencia",
  "Seguridad",
  "Profesionalismo",
  "Innovación",
  "Responsabilidad",
  "Trabajo en Equipo",
  "Respeto",
];
---

<section
  class="relative overflow-hidden bg-navy text-white px-6 py-16 md:px-20 flex flex-col gap-16"
>
  <!-- Mission and Vision -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-center md:text-left">
    <div>
      <h2 class="text-4xl font-bold mb-4">Misión</h2>
      <p class="text-lg leading-relaxed font-medium text-white/90">
        Educar a los profesionales del sector aeroportuario con formación de calidad,
        conforme a la normativa de la DGAC, asegurando que puedan desempeñarse de forma
        segura y competente en el ambiente aeroportuario y contribuyendo así a la seguridad
        de la aviación.
      </p>
    </div>

    <div>
      <h2 class="text-4xl font-bold mb-4">Visión</h2>
      <p class="text-lg leading-relaxed font-medium text-white/90">
        Ser un referente en formación en seguridad aeroportuaria en Chile y Latinoamérica,
        reconocido por la calidad de sus programas, la experiencia de su cuerpo docente y
        su aporte al cumplimiento normativo de las empresas del rubro.
      </p>
    </div>
  </div>

  <!-- Values -->
  <div class="flex flex-col items-center md:items-start gap-6">
    <h2 class="text-2xl font-bold tracking-wide">VALORES</h2>
    <div class="flex flex-wrap justify-center md:justify-start gap-3">
      {values.map((value) => <Badge label={value} />)}
    </div>
  </div>
</section>
