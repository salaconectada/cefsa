---
const links = [
  { href: "/", label: "Inicio" },
  { href: "/empresa", label: "Empresa" },
  { href: "/capacitaciones", label: "Capacitaciones" },
  { href: "/asesorias", label: "Asesorías" },
  { href: "/blog", label: "Blog" },
  { href: "/contacto", label: "Contacto" },
];
---

<nav class="bg-white shadow-md sticky top-0 left-0 w-full z-50">
  <div class="max-w-7xl mx-auto px-6 py-2 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 shrink-0">
      <img
        src="/logo-icon.png"
        alt="CEFSA"
        class="h-14 md:h-16 w-auto object-contain"
      />
      <span class="hidden sm:flex flex-col leading-tight">
        <span class="text-navy font-extrabold text-xl md:text-2xl tracking-wide">CEFSA</span>
        <span class="text-[11px] md:text-xs text-gray-500 font-semibold uppercase tracking-wider">
          Centro de Formación en Seguridad Aeroportuaria
        </span>
      </span>
    </a>

    <!-- Links md+ -->
    <ul class="hidden lg:flex items-center space-x-7">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="relative group text-gray-700 font-bold text-sm transition-colors duration-300 hover:text-navy"
            >
              {link.label}
              <span class="absolute left-0 -bottom-2 w-0 h-0.5 bg-green transition-all duration-300 group-hover:w-full" />
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="http://45.7.230.59/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2 text-white text-sm font-semibold rounded-3xl bg-navy hover:bg-navy-dark transition"
        >
          Aula Virtual
        </a>
      </li>
    </ul>

    <!-- Menú hamburguesa móvil -->
    <div class="lg:hidden relative">
      <input id="menu-toggle" type="checkbox" class="peer hidden" />

      <label for="menu-toggle" class="cursor-pointer z-50 flex items-center">
        <svg
          class="h-6 w-6 text-gray-700 peer-checked:hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>

        <svg
          class="h-6 w-6 text-gray-700 hidden peer-checked:block"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </label>

      <label
        for="menu-toggle"
        class="fixed inset-0 bg-black/60 hidden peer-checked:block cursor-pointer z-40"
      ></label>

      <div
        class="fixed top-0 right-0 h-full w-72 bg-white shadow-lg transform translate-x-full transition-transform duration-300 peer-checked:translate-x-0 z-50"
      >
        <div class="flex justify-end p-4">
          <label for="menu-toggle" class="cursor-pointer">
            <svg
              class="h-6 w-6 text-gray-700"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </label>
        </div>

        <ul class="flex flex-col space-y-6 mt-4 ml-6">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="text-gray-700 text-lg font-bold hover:text-navy">
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="http://45.7.230.59/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block px-5 py-2 text-white font-semibold rounded-lg bg-navy hover:bg-navy-dark transition"
            >
              Aula Virtual
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</nav>
