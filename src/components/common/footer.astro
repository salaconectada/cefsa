---
const year = new Date().getFullYear();

const links = [
  { href: "/", label: "Inicio" },
  { href: "/empresa", label: "Empresa" },
  { href: "/capacitaciones", label: "Capacitaciones" },
  { href: "/asesorias", label: "Asesorías" },
  { href: "/blog", label: "Blog" },
  { href: "/contacto", label: "Contacto" },
];
---

<footer class="bg-navy text-white mt-20 rounded-t-[2.5rem]">
  <div class="max-w-6xl mx-auto px-6 py-14 grid grid-cols-1 md:grid-cols-4 gap-10">
    <!-- LOGO + descripción -->
    <div class="md:col-span-2 flex flex-col items-center md:items-start text-center md:text-left">
      <div class="inline-block bg-white rounded-2xl px-6 py-4 mb-4">
        <img
          src="/logo-full.png"
          alt="CEFSA - Centro de Formación en Seguridad Aeroportuaria"
          class="h-20 md:h-24 w-auto object-contain"
        />
      </div>
      <p class="text-white/80 text-sm max-w-sm leading-relaxed">
        Centro de Formación en Seguridad Aeroportuaria. Capacitamos a los profesionales que
        garantizan la seguridad y eficiencia en los aeropuertos de Chile, conforme a la
        normativa de la DGAC.
      </p>
      <a
        href="https://aulavirtual.cefsa.cl/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block mt-5 px-5 py-2 text-sm font-semibold rounded-full bg-green text-navy hover:bg-green-dark transition"
      >
        Ir al Aula Virtual
      </a>
    </div>

    <!-- LINKS -->
    <div class="flex flex-col items-center md:items-start gap-3 text-center md:text-left">
      <h3 class="font-bold text-white/60 text-xs uppercase tracking-widest mb-1">Navegación</h3>
      {
        links.map((link) => (
          <a href={link.href} class="hover:text-green transition text-sm">
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- CONTACTO -->
    <div class="flex flex-col items-center md:items-start gap-3 text-center md:text-left">
      <h3 class="font-bold text-white/60 text-xs uppercase tracking-widest mb-1">Contacto</h3>
      <a href="tel:+56999572856" class="hover:text-green transition text-sm">
        +56 9 9957 2856
      </a>
      <a href="mailto:contacto@cefsa.cl" class="hover:text-green transition text-sm">
        contacto@cefsa.cl
      </a>
      <span class="text-sm text-white/80">Cobertura: aeropuertos de Chile</span>
      <a
        href="https://wa.me/56999572856"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-green transition text-sm"
      >
        WhatsApp
      </a>
    </div>
  </div>

  <div class="border-t border-white/15 py-5 px-6">
    <p class="max-w-6xl mx-auto text-center text-xs text-white/60">
      © {year} CEFSA — Centro de Formación en Seguridad Aeroportuaria. Todos los derechos reservados.
    </p>
  </div>
</footer>
