---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/blog/Breadcrumbs.astro";
---

<Layout
  title="Contacto"
  description="Contáctate con CEFSA para conocer nuestros cursos de seguridad aeroportuaria o solicitar una asesoría para tu empresa. Teléfono, WhatsApp y correo de contacto."
>
  <section class="px-6 py-16 max-w-7xl mx-auto">
    <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Contacto" }]} />

    <h1
      class="text-navy text-3xl md:text-4xl font-extrabold text-center uppercase mb-4"
    >
      Contáctanos
    </h1>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-12">
      Déjanos tu mensaje y te responderemos a la brevedad, o comunícate directamente por
      teléfono, WhatsApp o correo.
    </p>

    <div class="flex flex-col md:flex-row items-start gap-12">
      <!-- Datos de contacto -->
      <div class="w-full md:w-1/3 flex flex-col gap-6">
        <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
          <h2 class="font-bold text-navy mb-4 text-sm uppercase tracking-widest">
            Datos de contacto
          </h2>
          <ul class="flex flex-col gap-4 text-gray-700 text-sm">
            <li>
              <span class="block text-gray-400 text-xs uppercase font-semibold mb-1">Teléfono</span>
              <a href="tel:+56999572856" class="font-semibold hover:text-navy">+56 9 9957 2856</a>
            </li>
            <li>
              <span class="block text-gray-400 text-xs uppercase font-semibold mb-1">Correo</span>
              <a href="mailto:contacto@cefsa.cl" class="font-semibold hover:text-navy">contacto@cefsa.cl</a>
            </li>
            <li>
              <span class="block text-gray-400 text-xs uppercase font-semibold mb-1">Cobertura</span>
              <span class="font-semibold">Aeropuertos de Chile</span>
            </li>
          </ul>
          <a
            href="https://wa.me/56999572856"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-block w-full text-center bg-navy hover:bg-navy-dark text-white font-semibold px-6 py-3 rounded-full transition"
          >
            Escríbenos por WhatsApp
          </a>
        </div>

        <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
          <h2 class="font-bold text-navy mb-2 text-sm uppercase tracking-widest">
            ¿Ya eres alumno?
          </h2>
          <p class="text-gray-600 text-sm mb-4">
            Ingresa directamente a tu Aula Virtual para revisar tus cursos.
          </p>
          <a
            href="http://45.7.230.59/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block w-full text-center border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold px-6 py-3 rounded-full transition"
          >
            Ir al Aula Virtual
          </a>
        </div>
      </div>

      <!-- Formulario -->
      <div class="w-full md:w-2/3 bg-gray-50 rounded-2xl p-6 md:p-8">
        <form>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex flex-col">
              <label for="nombre" class="font-semibold text-navy mb-2">Nombre</label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                placeholder="Tu nombre"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-green"
                required
              />
            </div>

            <div class="flex flex-col">
              <label for="apellido" class="font-semibold text-navy mb-2">Apellido</label>
              <input
                type="text"
                id="apellido"
                name="apellido"
                placeholder="Tu apellido"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-green"
                required
              />
            </div>

            <div class="flex flex-col">
              <label for="correo" class="font-semibold text-navy mb-2">Correo electrónico</label>
              <input
                type="email"
                id="correo"
                name="correo"
                placeholder="tu@correo.com"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-green"
                required
              />
            </div>

            <div class="flex flex-col">
              <label for="telefono" class="font-semibold text-navy mb-2">Teléfono</label>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                placeholder="+56 9 ..."
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-green"
              />
            </div>

            <div class="flex flex-col md:col-span-2">
              <label for="empresa" class="font-semibold text-navy mb-2">Empresa (opcional)</label>
              <input
                type="text"
                id="empresa"
                name="empresa"
                placeholder="Nombre de tu empresa"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-green"
              />
            </div>
          </div>

          <div class="flex flex-col mt-6">
            <label for="mensaje" class="font-semibold text-navy mb-2">Mensaje</label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="5"
              placeholder="Cuéntanos qué curso o asesoría necesitas..."
              class="border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green resize-none"
              required></textarea>
          </div>

          <div class="text-center md:text-right mt-4">
            <button
              type="submit"
              class="bg-navy text-white hover:bg-navy-dark font-bold px-14 py-3 rounded-full cursor-pointer transition"
            >
              Enviar
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>
